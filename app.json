{
  "expo": {
    "name": "Bluetooth-Tracker",
    "slug": "Bluetooth-Tracker",
    "version": "1.0.0",
    "android": {
      "package": "com.anonymous.BluetoothTracker",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-location"
    ]
  }
}

